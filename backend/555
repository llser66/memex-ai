from app.database.session import SessionLocal
from app.database.models import EventMemory


db = SessionLocal()

events = db.query(EventMemory).all()

print("记忆数量：", len(events))

for event in events:
    print("------------------------")
    print("ID：", event.id)
    print("类型：", event.event_type)
    print("描述：", event.description)
    print("关联文档：", event.related_doc)
    print("时间：", event.created_at)

db.close()